{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catholiccomputer.com/principles.schema.json",
  "title": "Catholic Computer principles",
  "description": "The starting principles of Catholic Computer, as published on the site, in machine-readable form.",
  "type": "object",
  "required": ["principles"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "note": { "type": "string" },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable slug identifier." },
          "name": { "type": "string", "description": "Principle name, as shown on the site." },
          "statement": { "type": "string", "description": "The commitment, verbatim from the site." }
        }
      }
    },
    "signatures": {
      "type": "object",
      "description": "Where the names of people endorsing these principles are published.",
      "properties": {
        "description": { "type": "string" },
        "list": { "type": "string", "format": "uri" },
        "schema": { "type": "string", "format": "uri" }
      }
    }
  }
}
